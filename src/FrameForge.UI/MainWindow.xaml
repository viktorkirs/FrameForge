<Window x:Class="FrameForge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FrameForge.UI"
        Title="FrameForge Recorder"
        Width="760"
        Height="680"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/FrameForge;component/Assets/frameforge-logo.png"
        Background="{StaticResource BgBrush}">
  <WindowChrome.WindowChrome>
    <!-- 6px resize edge + 46 covers the title row (1px border, 10px margin, 36px row) and stops above the preview. -->
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" UseAeroCaptionButtons="False" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Assets/Icons.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Indeterminate on purpose: Media Foundation finalize has no percent. -->
      <Style x:Key="FinishBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#FF8EB4FF"/>
        <Setter Property="Background" Value="#FF2A3142"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Border x:Name="Track" Height="6" CornerRadius="3" ClipToBounds="True">
                <Border.Background>
                  <LinearGradientBrush x:Name="Sweep" MappingMode="RelativeToBoundingBox" SpreadMethod="Repeat" StartPoint="-1,0" EndPoint="0,0">
                    <GradientStop Color="#FF2A3142" Offset="0"/>
                    <GradientStop Color="#FF2A3142" Offset="0.4"/>
                    <GradientStop Color="#FF8EB4FF" Offset="0.5"/>
                    <GradientStop Color="#FF2A3142" Offset="0.6"/>
                    <GradientStop Color="#FF2A3142" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsVisible" Value="True">
                  <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SweepStory">
                      <Storyboard RepeatBehavior="Forever">
                        <PointAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="StartPoint" From="-1,0" To="0,0" Duration="0:0:1.2"/>
                        <PointAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="EndPoint" From="0,0" To="1,0" Duration="0:0:1.2"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="SweepStory"/>
                  </Trigger.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid Margin="16,10,16,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown"
            AutomationProperties.AutomationId="TitleBar" AutomationProperties.Name="TitleBar">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="FrameForge logo">
            <Ellipse.Fill>
              <ImageBrush ImageSource="pack://application:,,,/FrameForge;component/Assets/frameforge-logo.png" Stretch="UniformToFill"/>
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="FrameForge" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
          <TextBlock Text="Recorder" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource IconButton}" Command="{Binding EditVideoCommand}"
                  ToolTip="{Binding [EditVideo], Source={x:Static local:TextTable.Instance}}"
                  AutomationProperties.Name="{Binding [EditVideo], Source={x:Static local:TextTable.Instance}}">
            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding AboutCommand}"
                  ToolTip="{Binding [About], Source={x:Static local:TextTable.Instance}}"
                  AutomationProperties.Name="{Binding [About], Source={x:Static local:TextTable.Instance}}">
            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" ToolTip="{Binding [Settings], Source={x:Static local:TextTable.Instance}}">
            <Image Source="{StaticResource IconSettings}" Width="16" Height="16"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="{Binding [Minimize], Source={x:Static local:TextTable.Instance}}">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
          </Button>
          <Button x:Name="CloseWindowButton" Style="{StaticResource CloseButton}" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <DockPanel Grid.Row="1">
      <Border x:Name="UpdateNotice" DockPanel.Dock="Top" DataContext="{Binding Updates}" Margin="0,10,0,0" Padding="12,9"
              Background="#FF243B5B" CornerRadius="8" Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button Grid.Column="1" Content="{Binding [UpdateDownload], Source={x:Static local:TextTable.Instance}}"
                  Command="{Binding DownloadCommand}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                  Padding="10,6" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
          <Button Grid.Column="2" Style="{StaticResource CloseButton}" Command="{Binding DismissCommand}" Margin="8,0,0,0"/>
        </Grid>
      </Border>
      <Border Margin="0,12,0,12" Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="12">
        <Grid>
          <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="1"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
            <Image Source="{StaticResource IconScreen}" Width="28" Height="28" Opacity="0.55" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MonitorLabel}" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding [Preview], Source={x:Static local:TextTable.Instance}}" Margin="14,10,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Top" IsHitTestVisible="False"/>
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" Background="#FF2A3142" CornerRadius="10" Padding="8,3">
            <TextBlock Text="{Binding ResolutionText}" FontSize="11" Foreground="{StaticResource TextBrush}"/>
          </Border>
          <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Background="Transparent" BorderThickness="0"
                  Command="{Binding CycleMonitorCommand}" Cursor="Hand" ToolTip="{Binding [NextMonitor], Source={x:Static local:TextTable.Instance}}">
            <TextBlock Text="{Binding MonitorLabel}" Foreground="{StaticResource TextBrush}" FontSize="13"/>
          </Button>
          <Border VerticalAlignment="Bottom" Margin="10" Background="#CC0E1218" CornerRadius="8" Padding="12,8"
                  Visibility="{Binding ShowElapsed, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource RecordBrush}" Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding TimerText}" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right">
                  <TextBlock Text="{Binding StatsText}" FontSize="12" HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding EncoderText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
              <ProgressBar Style="{StaticResource FinishBar}" Margin="0,8,0,0"
                           Visibility="{Binding IsFinishing, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      </DockPanel>
      <StackPanel Grid.Row="2" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource ModeButton}" Margin="0,0,8,0"
                  Command="{Binding ScreenModeCommand}" Tag="{Binding ScreenTag}">
            <StackPanel>
              <Image Source="{StaticResource IconScreen}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding [Screen], Source={x:Static local:TextTable.Instance}}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource ModeButton}" Margin="4,0"
                  Command="{Binding WindowModeCommand}" Tag="{Binding WindowTag}">
            <StackPanel>
              <Image Source="{StaticResource IconWindow}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding [Window], Source={x:Static local:TextTable.Instance}}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource ModeButton}" Margin="8,0,0,0"
                  Command="{Binding RegionModeCommand}" Tag="{Binding RegionTag}">
            <StackPanel>
              <Image Source="{StaticResource IconRegion}" Width="18" Height="18" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding [Region], Source={x:Static local:TextTable.Instance}}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Text="{Binding TargetText}" Margin="4,8,4,0" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel Grid.Row="3" Margin="4,0,4,8">
        <Grid Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconVolume}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding [SystemAudio], Source={x:Static local:TextTable.Instance}}" VerticalAlignment="Center"/>
            <local:AudioLevelIndicator Margin="10,0,0,0" VerticalAlignment="Center" Level="{Binding SystemAudioLevel}"
                                      IsActive="{Binding SystemAudioActive}" AutomationProperties.Name="{Binding [SystemAudio], Source={x:Static local:TextTable.Instance}}"/>
          </StackPanel>
          <ToggleButton Style="{StaticResource Pill}" HorizontalAlignment="Right" IsChecked="{Binding SystemAudio}" IsEnabled="{Binding IsRecording, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
        </Grid>
        <Grid>
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconMicrophone}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding [Microphone], Source={x:Static local:TextTable.Instance}}" VerticalAlignment="Center"/>
            <local:AudioLevelIndicator Margin="10,0,0,0" VerticalAlignment="Center" Level="{Binding MicrophoneLevel}"
                                      IsActive="{Binding MicrophoneActive}" SignalColor="#FF64D5AD" AutomationProperties.Name="{Binding [Microphone], Source={x:Static local:TextTable.Instance}}"/>
          </StackPanel>
          <ToggleButton Style="{StaticResource Pill}" HorizontalAlignment="Right" IsChecked="{Binding Microphone}" IsEnabled="{Binding IsRecording, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
        </Grid>
        <TextBlock Text="{Binding AudioNote}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasAudioNote, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>

      <Border Grid.Row="4" Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,10"/>

      <Grid Grid.Row="5">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding [Quality], Source={x:Static local:TextTable.Instance}}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
          <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0"
                  Command="{Binding SettingsCommand}" Cursor="Hand">
            <TextBlock Text="{Binding QualityText}" FontSize="16" FontWeight="SemiBold"/>
          </Button>
          <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="10" HorizontalAlignment="Left"
                  Background="{StaticResource CardBrush}"
                  Visibility="{Binding ShowElapsed, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" Fill="{StaticResource RecordBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding TimerText}" FontSize="28" FontWeight="SemiBold" FontFamily="Consolas"
                         Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button Command="{Binding EditVideoCommand}" Margin="0,8,0,2" Padding="12,7" HorizontalAlignment="Left" Cursor="Hand"
                  Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}"
                  Content="{Binding [EditVideo], Source={x:Static local:TextTable.Instance}}"
                  Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
          <DockPanel Margin="0,6,0,0" MaxWidth="440" HorizontalAlignment="Left" LastChildFill="True">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,5" Cursor="Hand" VerticalAlignment="Center"
                    Command="{Binding OpenFolderCommand}"
                    Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource CardBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource IconFolder}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [OpenFolder], Source={x:Static local:TextTable.Instance}}" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFinishing}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DockPanel>
          <ProgressBar Style="{StaticResource FinishBar}" Width="280" Margin="0,8,0,0" HorizontalAlignment="Left"
                       Visibility="{Binding IsFinishing, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding DiskEstimate}" FontSize="12" TextWrapping="Wrap" MaxWidth="440" Margin="0,6,0,0" HorizontalAlignment="Left">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasDiskEstimate}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DiskEstimateLow}" Value="True">
                    <Setter Property="Foreground" Value="#FFF3D48A"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding MachineWarning}" FontSize="12" TextWrapping="Wrap" MaxWidth="440" Margin="0,4,0,0" HorizontalAlignment="Left">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFF3D48A"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasMachineWarning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Width="42" Height="42" Margin="0,0,8,0" Command="{Binding ScreenshotCommand}" ToolTip="{Binding [ScreenshotTip], Source={x:Static local:TextTable.Instance}}"
                  Background="{StaticResource CardBrush}" BorderThickness="0" Cursor="Hand">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                  <Image Source="{StaticResource IconCamera}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button Command="{Binding PauseCommand}" Margin="0,0,8,0" Height="42" Padding="14,0" Cursor="Hand"
                  Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource CardBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
            <TextBlock Text="{Binding PauseText}" FontWeight="SemiBold"/>
          </Button>
          <Button Command="{Binding RecordCommand}" Height="42" Padding="16,0" Cursor="Hand" BorderThickness="0" Foreground="White" Background="{StaticResource RecordBrush}">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{StaticResource RecordBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{StaticResource RecordBrush}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,8,0"/>
                          <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="White"/>
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{StaticResource RecordHoverBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <TextBlock Text="{Binding RecordText}" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
