<Window x:Class="FrameForge.UI.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FrameForge.UI"
        Title="{Binding [EditorTitle], Source={x:Static local:TextTable.Instance}}"
        Width="1160" Height="840" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" PreviewKeyDown="Window_KeyDown"
        Icon="pack://application:,,,/FrameForge;component/Assets/frameforge-logo.png">
  <Window.Resources>
    <Style x:Key="EditorButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="100"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock Text="{Binding [EditorTitle], Source={x:Static local:TextTable.Instance}}" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock x:Name="FileLabel" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="OpenButton" Style="{StaticResource EditorButton}" Content="{Binding [EditorOpen], Source={x:Static local:TextTable.Instance}}" Click="Open_Click"/>
        <Button x:Name="ExportButton" Style="{StaticResource EditorButton}" Background="{StaticResource AccentBrush}" Foreground="White"
                Content="{Binding [EditorExport], Source={x:Static local:TextTable.Instance}}" Click="Export_Click"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#080C12" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" Volume="0.8"
                      MediaOpened="Player_Opened" MediaEnded="Player_Ended" MediaFailed="Player_Failed" MouseLeftButtonDown="Player_Click"/>
        <Image x:Name="PausedFrame" Stretch="Uniform" Visibility="Collapsed" MouseLeftButtonDown="Player_Click"/>
        <TextBlock x:Name="PreviewMessage" Text="{Binding [EditorLoading], Source={x:Static local:TextTable.Instance}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="25"/>
      </Grid>
    </Border>
    <Grid x:Name="Transport" Grid.Row="2" Margin="0,10,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="PlayButton" Style="{StaticResource EditorButton}" Width="44" Content="▶" Click="Play_Click"
              ToolTip="{Binding [EditorPlay], Source={x:Static local:TextTable.Instance}}"/>
      <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Seek_Changed" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="10,0,18,0"/>
      <TextBlock x:Name="TimeLabel" Grid.Column="2" Text="00:00:00.000 / 00:00:00.000" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <WrapPanel x:Name="EditTools">
        <Button x:Name="SplitButton" Style="{StaticResource EditorButton}" Content="{Binding [EditorSplit], Source={x:Static local:TextTable.Instance}}" Click="Split_Click" ToolTip="Ctrl+B"/>
        <Button x:Name="DeleteButton" Style="{StaticResource EditorButton}" Content="{Binding [EditorDelete], Source={x:Static local:TextTable.Instance}}" Click="Delete_Click" ToolTip="Delete"/>
        <Button x:Name="MoveLeftButton" Style="{StaticResource EditorButton}" Content="←" Click="MoveLeft_Click" ToolTip="{Binding [EditorMoveLeft], Source={x:Static local:TextTable.Instance}}"/>
        <Button x:Name="MoveRightButton" Style="{StaticResource EditorButton}" Content="→" Click="MoveRight_Click" ToolTip="{Binding [EditorMoveRight], Source={x:Static local:TextTable.Instance}}"/>
        <Button x:Name="UndoButton" Style="{StaticResource EditorButton}" Content="↶" Click="Undo_Click" ToolTip="{Binding [EditorUndo], Source={x:Static local:TextTable.Instance}}"/>
        <Button x:Name="RedoButton" Style="{StaticResource EditorButton}" Content="↷" Click="Redo_Click" ToolTip="{Binding [EditorRedo], Source={x:Static local:TextTable.Instance}}"/>
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <TextBlock Text="{Binding [EditorZoom], Source={x:Static local:TextTable.Instance}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Slider x:Name="ZoomSlider" Width="100" Minimum="1" Maximum="24" Value="1" SmallChange="0.5" ValueChanged="Zoom_Changed" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="4" Background="#131925" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Height="182" VerticalAlignment="Top">
          <TextBlock Text="{Binding [EditorVideoTrack], Source={x:Static local:TextTable.Instance}}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="10,55,0,0" VerticalAlignment="Top"/>
          <TextBlock Text="{Binding [EditorAudioTrack], Source={x:Static local:TextTable.Instance}}" FontSize="10" Foreground="#67D9BD" Margin="10,119,0,0" VerticalAlignment="Top"/>
        </Grid>
        <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      SizeChanged="Timeline_SizeChanged" ScrollChanged="Timeline_ScrollChanged" CanContentScroll="False" Focusable="False">
          <local:VideoTimelineControl x:Name="TimelineCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>
      </Grid>
    </Border>
    <WrapPanel x:Name="TrimTools" Grid.Row="5" Margin="0,10,0,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding [EditorIn], Source={x:Static local:TextTable.Instance}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="TrimInBox" Width="130" FontFamily="Consolas" FontSize="12" Padding="8,6" Margin="0,0,14,0"/>
      <TextBlock Text="{Binding [EditorOut], Source={x:Static local:TextTable.Instance}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="TrimOutBox" Width="130" FontFamily="Consolas" FontSize="12" Padding="8,6" Margin="0,0,12,0"/>
      <Button Style="{StaticResource EditorButton}" Content="{Binding [EditorApplyTrim], Source={x:Static local:TextTable.Instance}}" Click="Trim_Click"/>
    </WrapPanel>
    <StackPanel Grid.Row="6" Margin="0,10,0,0">
      <TextBlock Text="{Binding [EditorHint], Source={x:Static local:TextTable.Instance}}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding [EditorLinked], Source={x:Static local:TextTable.Instance}}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
      <Grid Margin="0,7,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"/>
          <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Height="4" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <Button x:Name="CancelExportButton" Grid.Column="1" Style="{StaticResource EditorButton}" Content="{Binding [Cancel], Source={x:Static local:TextTable.Instance}}"
                Click="CancelExport_Click" Visibility="Collapsed"/>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
