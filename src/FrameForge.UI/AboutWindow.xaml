<Window x:Class="FrameForge.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FrameForge.UI"
        Title="{Binding [About], Source={x:Static local:TextTable.Instance}}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/FrameForge;component/Assets/frameforge-logo.png">
  <StackPanel Margin="28">
    <Image Source="pack://application:,,,/FrameForge;component/Assets/frameforge-logo.png" Width="72" Height="72"
           HorizontalAlignment="Left" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="FrameForge Recorder" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18"/>
    <TextBlock Text="{Binding [AboutDescription], Source={x:Static local:TextTable.Instance}}"
               TextWrapping="Wrap" Margin="0,0,0,22"/>
    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16">
      <StackPanel>
        <TextBlock Text="{Binding [Manufacturer], Source={x:Static local:TextTable.Instance}}"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <TextBlock Text="Victor Kirsanov" FontSize="18" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="ManufacturerName"/>
      </StackPanel>
    </Border>
    <Button Content="{Binding [Close], Source={x:Static local:TextTable.Instance}}"
            Width="110" Height="34" Margin="0,24,0,0" HorizontalAlignment="Right"
            IsCancel="True" IsDefault="True" Click="Close_Click"
            Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
  </StackPanel>
</Window>
